---
import { Icon } from 'astro-icon/components';
import type { Motor } from '../lib/api';
import { useTranslations } from '../i18n/utils';
import type { LocaleCode } from '../i18n/locales';
import { icons } from '../lib/icons';

interface Props {
  motor: Motor;
  lang: LocaleCode;
}

const { motor, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="booking-form-card @container min-w-0 rounded-[6px] border border-[#E2ECE8] bg-white p-5 shadow-md sm:p-6">
  <div>
    <h2 class="text-2xl font-extrabold tracking-tight text-[#1E293B]">
      {t('book.title')}
    </h2>
    <p class="mt-1 truncate text-xs text-[#5F7380] sm:text-sm">{t('book.subtitle')}</p>
  </div>

  <form
    id="booking-form"
    data-lang={lang}
    data-motor-name={motor.name}
    data-success-message={t('book.submit_success')}
    data-processing-message={t('book.submit_processing')}
    data-redirecting-message={t('book.submit_redirecting')}
    data-submit-error-message={t('book.submit_error')}
    data-submit-button={t('book.submit_btn')}
    class="mt-4 min-w-0 space-y-4 scroll-mt-24"
  >
    <input type="hidden" name="motor_id" value={motor.id} />

    <div class="grid min-w-0 grid-cols-1 gap-4">
      <div class="min-w-0">
        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-[#1E293B]" for="customer-name">
          {t('book.name_label')} *
        </label>
        <input
          id="customer-name"
          type="text"
          name="customer_name"
          required
          maxlength="100"
          autocomplete="name"
          placeholder={t('book.name_placeholder')}
          class="w-full min-w-0 rounded-[6px] border border-[#E2ECE8] bg-white px-4 py-3 text-sm text-[#1E293B] placeholder-[#8D9FA9] transition-colors focus:border-[#8ED8F8] focus:outline-none focus:ring-2 focus:ring-[#8ED8F8]/30"
        />
      </div>

      <div class="min-w-0">
        <label class="mb-2 block text-xs font-bold uppercase tracking-wider text-[#1E293B]" for="customer-email">
          {t('book.email_label')} *
        </label>
        <input
          id="customer-email"
          type="email"
          name="customer_email"
          required
          maxlength="255"
          autocomplete="email"
          placeholder={t('book.email_placeholder')}
          class="w-full min-w-0 rounded-[6px] border border-[#E2ECE8] bg-white px-4 py-3 text-sm text-[#1E293B] placeholder-[#8D9FA9] transition-colors focus:border-[#8ED8F8] focus:outline-none focus:ring-2 focus:ring-[#8ED8F8]/30"
        />
      </div>

      <!-- Consent Checkboxes (Both required to enable submit button) -->
      <div class="space-y-3 pt-1">
        <label for="agree-terms" class="flex items-start gap-3 cursor-pointer select-none">
          <input
            id="agree-terms"
            type="checkbox"
            name="agree_terms"
            required
            class="mt-0.5 h-4 w-4 shrink-0 rounded-[4px] border-[#CBD5E1] text-[#0284C7] accent-[#0284C7] focus:ring-[#8ED8F8] cursor-pointer"
          />
          <span class="text-xs sm:text-[13px] leading-snug text-[#5F7380]">
            {t('book.agree_terms')}
          </span>
        </label>

        <label for="agree-email" class="flex items-start gap-3 cursor-pointer select-none">
          <input
            id="agree-email"
            type="checkbox"
            name="agree_email"
            required
            class="mt-0.5 h-4 w-4 shrink-0 rounded-[4px] border-[#CBD5E1] text-[#0284C7] accent-[#0284C7] focus:ring-[#8ED8F8] cursor-pointer"
          />
          <span class="text-xs sm:text-[13px] leading-snug text-[#5F7380]">
            {t('book.agree_email')}
          </span>
        </label>
      </div>
    </div>

    <div id="success-alert" class="hidden items-center gap-2.5 rounded-[6px] border border-emerald-300 bg-emerald-50 p-4 text-xs font-semibold text-emerald-800">
      <Icon name={icons.circleCheck} class="h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true" />
      <span id="success-message">{t('book.submit_success')}</span>
    </div>
    <div id="error-alert" class="hidden rounded-[6px] border border-red-200 bg-red-50 p-4 text-xs font-semibold text-red-700"></div>
    <button
      type="submit"
      id="submit-btn"
      disabled
      class="btn-shimmer interactive-tap w-full cursor-pointer rounded-[6px] bg-[#8ED8F8] py-3.5 text-center text-xs font-bold tracking-wide text-[#0A2633] shadow-md transition-all hover:bg-[#72CBEF] hover:shadow-[0_8px_24px_rgba(142,216,248,0.35)] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-[#8ED8F8] disabled:hover:shadow-md sm:text-sm"
    >
      {t('book.submit_btn')}
    </button>
  </form>
</section>

<script>
  import { API_BASE_URL } from '../lib/api';
  import { buildBookingMessage } from '../lib/whatsapp';
  import type { LocaleCode } from '../i18n/locales';

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('customer-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('customer-email') as HTMLInputElement | null;
  const agreeTermsCheckbox = document.getElementById('agree-terms') as HTMLInputElement | null;
  const agreeEmailCheckbox = document.getElementById('agree-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const errorAlert = document.getElementById('error-alert');
  const successAlert = document.getElementById('success-alert');
  const successMessage = document.getElementById('success-message');
  const lang: LocaleCode = form?.getAttribute('data-lang') === 'en' ? 'en' : 'id';

  const getCookie = (name: string): string | null => {
    const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  };

  // Auto-fill customer name & email from cookies if user accepted cookies
  const prefillFromCookies = () => {
    if (getCookie('rmb_cookie_consent') === 'essential') return;
    const savedName = getCookie('rmb_customer_name');
    const savedEmail = getCookie('rmb_customer_email');
    if (nameInput && !nameInput.value && savedName) nameInput.value = savedName;
    if (emailInput && !emailInput.value && savedEmail) emailInput.value = savedEmail;
  };
  prefillFromCookies();

  const updateSubmitButtonState = () => {
    if (!submitBtn) return;
    const bothChecked = Boolean(agreeTermsCheckbox?.checked && agreeEmailCheckbox?.checked);
    submitBtn.disabled = !bothChecked;
  };

  agreeTermsCheckbox?.addEventListener('change', updateSubmitButtonState);
  agreeEmailCheckbox?.addEventListener('change', updateSubmitButtonState);
  updateSubmitButtonState();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!agreeTermsCheckbox?.checked || !agreeEmailCheckbox?.checked) {
      updateSubmitButtonState();
      return;
    }

    errorAlert?.classList.add('hidden');
    successAlert?.classList.add('hidden');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = form.getAttribute('data-processing-message') || '';
    }

    const formData = new FormData(form);
    const customerName = String(formData.get('customer_name') || '');
    const customerEmail = String(formData.get('customer_email') || '');

    // Save customer name & email in cookies if full cookies are accepted
    if (getCookie('rmb_cookie_consent') !== 'essential') {
      document.cookie = `rmb_customer_name=${encodeURIComponent(customerName)}; path=/; max-age=2592000; SameSite=Lax`;
      document.cookie = `rmb_customer_email=${encodeURIComponent(customerEmail)}; path=/; max-age=2592000; SameSite=Lax`;
    }

    const payload = {
      motor_id: Number(formData.get('motor_id')),
      customer_name: customerName,
      customer_email: customerEmail,
      lang,
      whatsapp_message: buildBookingMessage(lang, {
        motor: form.getAttribute('data-motor-name') || '',
        name: customerName,
        email: customerEmail,
      }),
    };

    try {
      const response = await fetch(`${API_BASE_URL}/bookings`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      const whatsappUrl = result.data?.whatsapp_url;

      if (!response.ok || !whatsappUrl) {
        throw new Error(result.message || form.getAttribute('data-submit-error-message') || '');
      }

      if (successMessage) {
        successMessage.innerText = form.getAttribute('data-success-message') || '';
      }
      successAlert?.classList.remove('hidden');
      successAlert?.classList.add('flex');
      if (submitBtn) {
        submitBtn.innerText = form.getAttribute('data-redirecting-message') || '';
      }
      window.location.href = whatsappUrl;
    } catch (error) {
      if (errorAlert) {
        errorAlert.innerText = error instanceof Error ? error.message : String(error);
        errorAlert.classList.remove('hidden');
      }
      if (submitBtn) {
        updateSubmitButtonState();
        submitBtn.innerText = form.getAttribute('data-submit-button') || '';
      }
    }
  });
</script>
