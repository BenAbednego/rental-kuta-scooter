---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { fetchReviewSettings, fetchTestimonials } from '../lib/api';
import { Icon } from 'astro-icon/components';
import { icons } from '../lib/icons';

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const reviews = await fetchTestimonials();
const reviewSettings = await fetchReviewSettings();

interface Props {
  bg?: string;
}

const { bg = "bg-white" } = Astro.props;
---

<!-- Testimonials Section -->
<section id="testimonials" class={`${bg} py-16 lg:py-24`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal max-w-2xl">
      <span class="text-xs sm:text-sm font-bold tracking-[0.16em] uppercase text-[#0284C7] block mb-2.5">
        {t("testi.eyebrow")}
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#1E293B] tracking-tight">
        {t("testi.headline")}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#5F7380] leading-relaxed">
        {t("testi.desc")}
      </p>
    </div>

    {reviewSettings.mode === 'iframe' && reviewSettings.iframe ? (
      <div class="reveal mt-12 w-full min-w-0 overflow-hidden">
        <iframe
          src={reviewSettings.iframe.src}
          title={reviewSettings.iframe.title || t('testi.iframe_title')}
          width="100%"
          height={Math.max(reviewSettings.iframe.height ?? 450, 300)}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          class="block w-full max-w-full border-0"
        ></iframe>
      </div>
    ) : (
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {reviews.map((item, idx) => (
          <div class={`reveal stagger-${(idx % 3) + 1} flex flex-col justify-between rounded-[6px] bg-white p-6 sm:p-7 border border-[#E2ECE8] shadow-sm hover:shadow-md transition-shadow`}>
            <div>
              <!-- Star rating in Sunny Yellow -->
              <div class="flex gap-1 text-[#EAB308] mb-3 text-sm tracking-wider" aria-label={`${item.rating} stars rating`}>
                {Array.from({ length: item.rating }, () => (
                  <Icon name={icons.star} class="h-4 w-4 fill-current" aria-hidden="true" />
                ))}
              </div>
              <p class="text-xs sm:text-sm text-[#5F7380] leading-relaxed">
                "{lang === 'en' ? item.text_en : item.text_id}"
              </p>
            </div>

            <div class="mt-6 border-t border-[#E2ECE8] pt-4">
              <span class="block text-sm font-bold text-[#1E293B]">{item.name}</span>
              <span class="text-xs text-[#8D9FA9] mt-0.5 block">{item.location}</span>
            </div>
          </div>
        ))}
      </div>
    )}

  </div>
</section>
