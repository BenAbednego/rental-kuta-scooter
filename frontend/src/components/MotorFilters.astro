---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Motor } from '../lib/api';
import type { TranslationKey } from '../i18n/ui';
import { Icon } from 'astro-icon/components';
import { icons } from '../lib/icons';

interface Props {
  motors: Motor[];
  action: string;
  selectedType?: string;
  selectedBrand?: string;
}

const { motors, action, selectedType = '', selectedBrand = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const types = [...new Set(motors.map((motor) => motor.category).filter(Boolean))].sort();
const brands = [...new Set(
  motors
    .map((motor) => motor.brand?.trim())
    .filter((brand): brand is string => Boolean(brand)),
)].sort();
const categoryKeys: Record<string, TranslationKey> = {
  matic: 'fleet.category.matic',
  premium: 'fleet.category.premium',
  sport: 'fleet.category.sport',
};
---

<form
  method="get"
  action={action}
  data-motor-filters
  class="relative z-30 grid min-w-0 grid-cols-[1fr_1fr_auto] items-center gap-2 rounded-[6px] border border-[#E2ECE8] bg-white p-2 shadow-lg sm:gap-3 sm:p-3 lg:grid-cols-[minmax(0,1fr)_minmax(145px,190px)_minmax(145px,190px)_auto] lg:gap-4 lg:px-5 lg:py-3.5"
>
  <h2 class="hidden min-w-0 self-center text-left font-extrabold tracking-[0.04em] text-[#0284C7] lg:block lg:text-[clamp(1.25rem,1.8vw,1.75rem)]">
    {t('fleet.search_heading')}
  </h2>
  <div class="filter-field relative min-w-0" data-filter-field>
    <select
      name="tipe"
      aria-label={t('fleet.filter_type')}
      class="h-10 sm:h-11 w-full min-w-0 rounded-[6px] border border-[#E2ECE8] bg-[#F8F9FA] px-2.5 sm:px-3 text-xs sm:text-sm text-[#1E293B] focus:border-[#8ED8F8] focus:outline-none focus:ring-2 focus:ring-[#8ED8F8]/30"
    >
      <option value="" selected={selectedType === ''}>{t('fleet.filter_all_types')}</option>
      {types.map((type) => (
        <option value={type} selected={selectedType === type}>
          {categoryKeys[type] ? t(categoryKeys[type]) : type}
        </option>
      ))}
    </select>
    <div class="custom-filter hidden" data-custom-filter hidden>
      <button
        type="button"
        class="flex min-h-10 sm:min-h-11 w-full min-w-0 items-center gap-1.5 sm:gap-2 rounded-[6px] border border-[#E2ECE8] bg-[#F8F9FA] px-2.5 sm:px-3 text-left text-xs sm:text-sm text-[#1E293B] transition-colors hover:border-[#8ED8F8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8ED8F8]/50"
        data-filter-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span class="shrink-0 text-[10px] font-bold uppercase tracking-[0.1em] text-[#5F7380]" data-filter-label>
          {t('fleet.filter_type')}
        </span>
        <span class="min-w-0 flex-1 truncate font-medium" data-filter-value></span>
        <Icon name={icons.chevronDown} class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0 text-[#5F7380] transition-transform" aria-hidden="true" data-filter-chevron />
      </button>
      <div
        class="absolute left-0 top-full z-[100] mt-1.5 max-h-60 w-full min-w-[max(100%,11rem)] overflow-y-auto rounded-[6px] border border-[#E2ECE8] bg-white p-1.5 shadow-xl"
        data-filter-listbox
        role="listbox"
        hidden
      ></div>
      <template data-filter-option-template>
        <div
          class="flex min-h-10 cursor-pointer items-center gap-2 rounded-[4px] px-3 py-2 text-xs sm:text-sm text-[#1E293B] outline-none transition-colors hover:bg-[#F0F9FF] focus:bg-[#F0F9FF]"
          role="option"
          tabindex="-1"
          data-filter-option
        >
          <span class="min-w-0 flex-1"></span>
          <span class="hidden shrink-0 text-[#0284C7]" data-filter-check>
            <Icon name={icons.check} class="h-4 w-4" aria-hidden="true" />
          </span>
        </div>
      </template>
    </div>
  </div>

  <div class="filter-field relative min-w-0" data-filter-field>
    <select
      name="brand"
      disabled={brands.length === 0}
      aria-label={t('fleet.filter_brand')}
      class="h-10 sm:h-11 w-full min-w-0 rounded-[6px] border border-[#E2ECE8] bg-[#F8F9FA] px-2.5 sm:px-3 text-xs sm:text-sm text-[#1E293B] focus:border-[#8ED8F8] focus:outline-none focus:ring-2 focus:ring-[#8ED8F8]/30 disabled:cursor-not-allowed disabled:text-[#667085]"
    >
      <option value="" selected={selectedBrand === ''}>{t('fleet.filter_all_brands')}</option>
      {brands.map((brand) => (
        <option value={brand} selected={selectedBrand === brand}>{brand}</option>
      ))}
    </select>
    <div class="custom-filter hidden" data-custom-filter hidden>
      <button
        type="button"
        class="flex min-h-10 sm:min-h-11 w-full min-w-0 items-center gap-1.5 sm:gap-2 rounded-[6px] border border-[#E2ECE8] bg-[#F8F9FA] px-2.5 sm:px-3 text-left text-xs sm:text-sm text-[#1E293B] transition-colors hover:border-[#8ED8F8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8ED8F8]/50 disabled:cursor-not-allowed disabled:text-[#667085]"
        data-filter-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span class="shrink-0 text-[10px] font-bold uppercase tracking-[0.1em] text-[#5F7380]" data-filter-label>
          {t('fleet.filter_brand')}
        </span>
        <span class="min-w-0 flex-1 truncate font-medium" data-filter-value></span>
        <Icon name={icons.chevronDown} class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0 text-[#5F7380] transition-transform" aria-hidden="true" data-filter-chevron />
      </button>
      <div
        class="absolute left-0 top-full z-[100] mt-1.5 max-h-60 w-full min-w-[max(100%,11rem)] overflow-y-auto rounded-[6px] border border-[#E2ECE8] bg-white p-1.5 shadow-xl"
        data-filter-listbox
        role="listbox"
        hidden
      ></div>
      <template data-filter-option-template>
        <div
          class="flex min-h-10 cursor-pointer items-center gap-2 rounded-[4px] px-3 py-2 text-xs sm:text-sm text-[#1E293B] outline-none transition-colors hover:bg-[#F0F9FF] focus:bg-[#F0F9FF]"
          role="option"
          tabindex="-1"
          data-filter-option
        >
          <span class="min-w-0 flex-1"></span>
          <span class="hidden shrink-0 text-[#0284C7]" data-filter-check>
            <Icon name={icons.check} class="h-4 w-4" aria-hidden="true" />
          </span>
        </div>
      </template>
    </div>
  </div>

  <div class="flex min-w-0 items-center">
    <button
      type="submit"
      class="inline-flex min-h-10 sm:min-h-11 items-center justify-center gap-1.5 sm:gap-2 rounded-[6px] bg-[#0284C7] px-3.5 sm:px-5 text-xs sm:text-sm font-bold text-white transition-colors hover:bg-[#0369A1] whitespace-nowrap"
    >
      <Icon name={icons.search} class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0" aria-hidden="true" />
      <span>{t('fleet.search_bike')}</span>
    </button>
  </div>
</form>

<script>
  const initMotorFilterDropdowns = () => {
    document.querySelectorAll<HTMLFormElement>('[data-motor-filters]').forEach((form) => {
      if (form.dataset.enhanced === 'true') return;

      const fields = Array.from(form.querySelectorAll<HTMLElement>('[data-filter-field]'));
      fields.forEach((field, fieldIndex) => {
        const select = field.querySelector<HTMLSelectElement>('select');
        const custom = field.querySelector<HTMLElement>('[data-custom-filter]');
        const trigger = field.querySelector<HTMLButtonElement>('[data-filter-trigger]');
        const valueLabel = field.querySelector<HTMLElement>('[data-filter-value]');
        const listbox = field.querySelector<HTMLElement>('[data-filter-listbox]');
        const template = field.querySelector<HTMLTemplateElement>('[data-filter-option-template]');
        const chevron = field.querySelector<HTMLElement>('[data-filter-chevron]');

        if (!select || !custom || !trigger || !valueLabel || !listbox || !template) return;

        const listboxId = `motor-filter-listbox-${fieldIndex}`;
        listbox.id = listboxId;
        listbox.setAttribute('aria-label', field.querySelector('[data-filter-label]')?.textContent?.trim() || '');
        trigger.setAttribute('aria-controls', listboxId);
        trigger.disabled = select.disabled;

        const close = (returnFocus = false) => {
          listbox.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('rotate-180');
          if (returnFocus) trigger.focus();
        };

        const updateSelection = () => {
          const selected = select.options[select.selectedIndex];
          valueLabel.textContent = select.value ? selected?.textContent?.trim() || '' : '';
          listbox.querySelectorAll<HTMLElement>('[data-filter-option]').forEach((option) => {
            const active = option.dataset.value === select.value;
            option.setAttribute('aria-selected', String(active));
            option.classList.toggle('bg-[#F0F9FF]', active);
            option.classList.toggle('font-semibold', active);
            option.querySelector<HTMLElement>('[data-filter-check]')?.classList.toggle('hidden', !active);
          });
        };

        const options = Array.from(select.options);
        options.forEach((option) => {
          const optionNode = template.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
          if (!optionNode) return;
          optionNode.dataset.value = option.value;
          const label = optionNode.querySelector<HTMLElement>(':scope > span');
          if (label) label.textContent = option.textContent?.trim() || '';

          optionNode.addEventListener('click', () => {
            select.value = option.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            updateSelection();
            close(true);
          });

          listbox.append(optionNode);
        });

        const optionNodes = () => Array.from(listbox.querySelectorAll<HTMLElement>('[data-filter-option]'));
        const focusOption = (index: number) => {
          const optionsNow = optionNodes();
          if (optionsNow.length === 0) return;
          const boundedIndex = (index + optionsNow.length) % optionsNow.length;
          optionsNow[boundedIndex].focus();
        };

        const open = (index = select.selectedIndex) => {
          document.querySelectorAll<HTMLElement>('[data-filter-listbox]:not([hidden])').forEach((opened) => {
            if (opened !== listbox) {
              opened.hidden = true;
              const otherTrigger = opened.parentElement?.querySelector<HTMLButtonElement>('[data-filter-trigger]');
              otherTrigger?.setAttribute('aria-expanded', 'false');
              opened.parentElement?.querySelector('[data-filter-chevron]')?.classList.remove('rotate-180');
            }
          });
          listbox.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
          focusOption(Math.max(0, index));
        };

        trigger.addEventListener('click', () => {
          if (listbox.hidden) open();
          else close();
        });

        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            open(select.selectedIndex + (event.key === 'ArrowDown' ? 1 : -1));
          } else if (event.key === 'Home') {
            event.preventDefault();
            open(0);
          } else if (event.key === 'End') {
            event.preventDefault();
            open(options.length - 1);
          }
        });

        listbox.addEventListener('keydown', (event) => {
          const currentIndex = optionNodes().indexOf(document.activeElement as HTMLElement);
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            focusOption(currentIndex + (event.key === 'ArrowDown' ? 1 : -1));
          } else if (event.key === 'Home') {
            event.preventDefault();
            focusOption(0);
          } else if (event.key === 'End') {
            event.preventDefault();
            focusOption(options.length - 1);
          } else if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            const activeOption = document.activeElement as HTMLElement;
            activeOption.click();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            close(true);
          } else if (event.key === 'Tab') {
            close();
          }
        });

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;

          if (!field.contains(target) && !listbox.hidden) {
            close();
          }
        });

        select.addEventListener('change', updateSelection);
        select.hidden = true;
        custom.hidden = false;
        custom.classList.remove('hidden');
        updateSelection();
      });

      form.dataset.enhanced = 'true';
    });
  };

  document.addEventListener('DOMContentLoaded', initMotorFilterDropdowns);
  document.addEventListener('astro:page-load', initMotorFilterDropdowns);
  initMotorFilterDropdowns();
</script>
