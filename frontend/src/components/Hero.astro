---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import { icons } from "../lib/icons";
import MotorFilters from "./MotorFilters.astro";
import { fetchHero, type Motor } from "../lib/api";

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
const isEn = lang === "en";

interface Props {
  motors: Motor[];
}

const { motors } = Astro.props;
const background = await fetchHero();
const youtubeId = background.video?.source === 'youtube'
  && typeof background.video.youtube_id === 'string'
  && /^[A-Za-z0-9_-]{11}$/.test(background.video.youtube_id)
  ? background.video.youtube_id
  : null;
---

<!-- Hero Section: Full-Bleed Panoramic Bali Sunset Hero with kuta-2 -->
<section class="relative w-full min-h-screen min-h-[100svh] flex items-center justify-center pt-20 sm:pt-24 pb-24 sm:pb-24">
  
  <div class="absolute inset-0 w-full h-full -z-10 overflow-hidden">
    {background.type === 'single_image' && background.image_url ? (
      <img
        src={background.image_url}
        alt=""
        class="h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    ) : background.type === 'slider' && background.slides?.length ? (
      <div class="absolute inset-0" data-hero-slider data-interval={background.slide_interval ?? 5}>
        {background.slides.map((slide, index) => (
          <img
            src={slide}
            alt=""
            class={`hero-slide absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            aria-hidden={index !== 0}
            data-hero-slide
          />
        ))}
      </div>
    ) : background.type === 'video' && background.video?.source === 'upload' && background.video.url ? (
      <>
        <img
          src={background.poster_url || '/images/kuta-2.jpg'}
          alt=""
          class="hero-video-poster h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
        <video
          class="hero-video-media absolute inset-0 h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={background.poster_url || '/images/kuta-2.jpg'}
          aria-hidden="true"
        >
          <source src={background.video.url} />
        </video>
      </>
    ) : background.type === 'video' && background.video?.source === 'youtube' && youtubeId ? (
      <>
        <img
          src={background.poster_url || '/images/kuta-2.jpg'}
          alt=""
          class="hero-video-poster h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
        <iframe
          class="hero-youtube-frame"
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=1&loop=1&playlist=${youtubeId}&controls=0&modestbranding=1&playsinline=1&rel=0`}
          title={t('hero.video_title')}
          allow="autoplay; encrypted-media; picture-in-picture"
          aria-hidden="true"
          tabindex="-1"
        ></iframe>
      </>
    ) : (
      <img
        src="/images/kuta-2.jpg"
        alt="Rental Motor Kuta Bali - Sunset Gerbang Lempuyang Bali"
        class="w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <!-- Cinematic Gradient Overlay: Enhances text readability while preserving sunset beauty -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/30"></div>
    <div class="absolute inset-0 bg-black/15"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full text-left flex flex-col items-start">

    <!-- Responsive Headline -->
    <h1 
      class="hero-fade-in font-extrabold text-white tracking-tight leading-[1.14] drop-shadow-md max-w-2xl"
      style="font-size: clamp(2.25rem, 5vw, 4rem);"
    >
      {isEn ? (
        <>
          Explore Bali with the <span class="text-[#8ED8F8]">Best Motorcycles.</span>
        </>
      ) : (
        <>
          Jelajahi Bali dengan <span class="text-[#8ED8F8]">Motor Pilihanmu.</span>
        </>
      )}
    </h1>

    <!-- Description -->
    <p class="hero-fade-in hero-delay-1 mt-4 sm:mt-6 text-base sm:text-lg text-white/90 leading-relaxed max-w-xl font-medium drop-shadow-sm">
      {t('hero.desc')}
    </p>

    <!-- CTA Buttons -->
    <div class="hero-fade-in hero-delay-2 mt-8 sm:mt-10 flex flex-wrap items-center justify-start gap-4">
      <!-- Primary CTA: SEWA SEKARANG (Sky Blue) -->
      <a 
        href={`/${lang}/katalog`}
        class="btn-shimmer interactive-tap inline-flex items-center justify-center gap-2 rounded-[6px] bg-[#8ED8F8] hover:bg-[#72CBEF] px-7 sm:px-8 py-3.5 text-xs sm:text-sm font-bold text-[#0A2633] transition-all tracking-wide shadow-lg hover:shadow-[0_8px_24px_rgba(142,216,248,0.45)] cursor-pointer"
      >
        <span>{t('hero.cta_primary')}</span>
        <Icon name={icons.arrowRight} class="h-4 w-4" aria-hidden="true" />
      </a>

      <!-- Secondary CTA: LIHAT ARMADA (Frosted Glass on Sunset) -->
      <a 
        href={`/${lang}/katalog`}
        class="interactive-tap inline-flex items-center justify-center rounded-[6px] border border-white/40 bg-white/15 hover:bg-white/25 backdrop-blur-md px-7 sm:px-8 py-3.5 text-xs sm:text-sm font-bold text-white transition-all tracking-wide shadow-md cursor-pointer"
      >
        {t('hero.cta_secondary')}
      </a>
    </div>

  </div>

  <!-- Mobile & Tablet Search Bar: Positioned right between Hero image and white section below -->
  <div class="absolute bottom-0 left-1/2 z-20 w-full max-w-7xl -translate-x-1/2 translate-y-1/2 px-4 text-left sm:px-6 lg:hidden">
    <MotorFilters motors={motors} action={`/${lang}/katalog`} />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-slider]').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLImageElement>('[data-hero-slide]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slides.length < 2 || reducedMotion) return;

    const interval = Math.max(2, Number(slider.dataset.interval) || 5) * 1000;
    let activeIndex = 0;

    window.setInterval(() => {
      slides[activeIndex].classList.remove('opacity-100');
      slides[activeIndex].classList.add('opacity-0');
      slides[activeIndex].setAttribute('aria-hidden', 'true');
      activeIndex = (activeIndex + 1) % slides.length;
      slides[activeIndex].classList.remove('opacity-0');
      slides[activeIndex].classList.add('opacity-100');
      slides[activeIndex].setAttribute('aria-hidden', 'false');
    }, interval);
  });
</script>

<style>
  .hero-youtube-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78vh);
    height: max(100%, 56.25vw);
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-media,
    .hero-youtube-frame {
      display: none;
    }
  }
</style>
