---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Icon } from 'astro-icon/components';
import { DEFAULT_WHATSAPP_NUMBER, fetchSettings, formatPhoneNumber, sanitizeWaNumber } from '../lib/api';
import { buildBookingMessage } from '../lib/whatsapp';
import { icons } from '../lib/icons';

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const settings = await fetchSettings();
const rawWaNumber = settings.whatsapp_primary || DEFAULT_WHATSAPP_NUMBER;
const waNumber = sanitizeWaNumber(rawWaNumber);
const displayPhone = formatPhoneNumber(waNumber, true);
const address = settings.business_address || t('contact.address');
const operatingHours = (lang === 'en' ? settings.operating_hours_en : settings.operating_hours_id) || t('contact.hours');

const waMessage = buildBookingMessage(lang);
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;

interface Props {
  bg?: string;
}

const { bg = "bg-white" } = Astro.props;
---

<!-- Section: Lokasi & Kontak -->
<section id="contact" class={`${bg} py-16 lg:py-24`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Contact Information List -->
      <div class="reveal lg:col-span-5">
        <span class="text-xs sm:text-sm font-bold tracking-[0.16em] uppercase text-[#0284C7] block mb-2.5">
          {t("contact.eyebrow")}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#1E293B] tracking-tight">
          {t("contact.headline")}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#5F7380] leading-relaxed">
          {t("contact.desc")}
        </p>

        <!-- Clean Info List -->
        <div class="mt-8 space-y-6">
          
          <!-- Address -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] bg-white border border-[#E2ECE8] text-[#0284C7] shadow-sm">
              <Icon name={icons.mapPin} class="h-4 w-4 stroke-[2]" aria-hidden="true" />
            </div>
            <div>
              <span class="text-xs font-bold text-[#1E293B] uppercase tracking-wider block">
                {t('contact.address_title')}
              </span>
              <p class="mt-1 text-sm text-[#5F7380]">
                {address}
              </p>
            </div>
          </div>

          <!-- Operating Hours -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] bg-white border border-[#E2ECE8] text-[#0284C7] shadow-sm">
              <Icon name={icons.clock} class="h-4 w-4 stroke-[2]" aria-hidden="true" />
            </div>
            <div>
              <span class="text-xs font-bold text-[#1E293B] uppercase tracking-wider block">
                {t('contact.hours_title')}
              </span>
              <p class="mt-1 text-sm text-[#5F7380]">
                {operatingHours}
              </p>
            </div>
          </div>

          <!-- Phone Number -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[6px] bg-white border border-[#E2ECE8] text-[#0284C7] shadow-sm">
              <Icon name={icons.phone} class="h-4 w-4 stroke-[2]" aria-hidden="true" />
            </div>
            <div>
              <span class="text-xs font-bold text-[#1E293B] uppercase tracking-wider block">
                {t('contact.phone_title')}
              </span>
              <a href={`tel:+${waNumber}`} class="mt-1 text-sm text-[#5F7380] hover:text-[#0284C7] transition-colors block">
                {displayPhone}
              </a>
            </div>
          </div>

        </div>

        <!-- WhatsApp CTA Button: HUBUNGI KAMI VIA WA -->
        <div class="mt-8">
          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-[6px] bg-[#25D366] hover:bg-[#1EBE5A] px-6 py-3.5 text-xs sm:text-sm font-semibold text-white transition-all tracking-wide shadow-sm hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(37,211,102,0.25)]"
          >
            <Icon name={icons.messageCircle} class="h-4 w-4" aria-hidden="true" />
            <span>{t('contact.cta_wa')}</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Google Maps Embed -->
      <div class="reveal stagger-2 lg:col-span-7">
        <div class="overflow-hidden rounded-[6px] border border-[#E2ECE8] bg-white h-80 sm:h-96 w-full shadow-md">
          <iframe 
            title="Garage Location Kuta Bali"
            src="https://maps.google.com/maps?q=Jl.+Pantai+Kuta+No.+88,+Badung,+Bali&t=&z=14&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>
