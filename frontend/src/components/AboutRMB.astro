---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import { icons } from "../lib/icons";

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const points = [
  lang === "en" ? "2 Sanitized SNI Helmets" : "2 Helm SNI Higienis",
  lang === "en" ? "Ready-to-Use Raincoats" : "Jas Hujan Siap Pakai",
  lang === "en" ? "Free Delivery Area Kuta" : "Free Delivery Area Kuta",
  lang === "en" ? "24/7 Emergency Assistance" : "Layanan Darurat 24 Jam",
];

// Carousel slider images: kuta-5, kuta-6, kuta-7, kuta-8, kuta-9
const sliderImages = [
  { src: "/images/kuta-5.jpeg", alt: "Sewa Motor Kuta Bali - Sunset Canggu & Seminyak" },
  { src: "/images/kuta-6.jpeg", alt: "Sewa Motor Kuta Bali - Suasana Sunset Pantai Kuta" },
  { src: "/images/kuta-7.jpeg", alt: "Sewa Motor Kuta Bali - Petualangan Jelajah Bali" },
  { src: "/images/kuta-8.jpeg", alt: "Sewa Motor Kuta Bali - Wisata Pantai & Sunset Bali" },
  { src: "/images/kuta-9.jpeg", alt: "Sewa Motor Kuta Bali - Armada Nyaman & Terpercaya" },
];

// Display list with cloned ends for seamless infinite horizontal loop
const displaySlides = [
  sliderImages[sliderImages.length - 1], // Clone of last slide (index 0)
  ...sliderImages,                        // Real slides (index 1 to 5)
  sliderImages[0],                        // Clone of first slide (index 6)
];
---

<!-- Section: Tentang RMB (2-Column Minimalist Layout on Pure White) -->
<section id="about" class="bg-white pt-16 sm:pt-20 lg:pt-24 pb-6 sm:pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Copywriting & Bullet Points -->
      <div class="reveal lg:col-span-6">
        <span class="text-xs sm:text-sm font-bold tracking-[0.16em] uppercase text-[#0284C7] block mb-2.5">
          {t("about.eyebrow")}
        </span>

        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#1E293B] tracking-tight leading-tight">
          {lang === "en" ? "Explore Bali Freely, Without the Hassle" : "Bebas Menjelajah Bali, Tanpa Ribet"}
        </h2>

        <div class="mt-4 space-y-3.5 text-sm sm:text-base text-[#5F7380] leading-relaxed">
          {lang === "en" ? (
            <>
              <p>
                Bali has so many places to explore, and a motorbike is one of the most comfortable ways to enjoy them.{" "}
                <strong>RMB provides practical and reliable motorbike rentals to accompany you throughout your time in Bali.</strong>
              </p>
              <p>
                With a well-maintained selection of automatic scooters and maxi scooters, you can explore Kuta, Seminyak, Canggu, and other destinations with greater flexibility.
              </p>
              <p>
                Booking is simple, <strong>pricing is transparent from the start</strong>, and delivery and pickup are available at hotels and the airport. That way, you can focus on enjoying your trip without worrying about renting a motorbike.
              </p>
            </>
          ) : (
            <>
              <p>
                Bali punya banyak tempat untuk dijelajahi, dan motor adalah salah satu cara paling nyaman untuk menikmatinya.{" "}
                <strong>RMB menyediakan rental motor yang praktis dan terpercaya untuk menemani perjalananmu selama di Bali.</strong>
              </p>
              <p>
                Dengan pilihan motor matic dan maxi yang terawat, kamu bebas menjelajahi Kuta, Seminyak, Canggu, hingga berbagai destinasi lainnya dengan lebih fleksibel.
              </p>
              <p>
                Proses booking dibuat sederhana, <strong>harga transparan sejak awal</strong>, dan layanan antar-jemput tersedia untuk hotel maupun bandara. Jadi, kamu bisa fokus menikmati perjalanan tanpa perlu khawatir dengan urusan sewa motor.
              </p>
            </>
          )}
        </div>

        <!-- 4 Key Points in Clean Minimalist List -->
        <div class="mt-6 space-y-3.5">
          {points.map((point) => (
            <div class="flex items-center gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#A7E8D0] text-[#0E4F39]">
                <Icon name={icons.circleCheck} class="h-3.5 w-3.5" aria-hidden="true" />
              </span>
              <span class="text-sm font-semibold text-[#1E293B]">
                {point}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Visual Photo / Showroom Atmosphere -->
      <div class="reveal stagger-2 lg:col-span-6">
        <div 
          id="home-about-slider-container"
          class="relative overflow-hidden rounded-[6px] border border-[#E2ECE8] bg-white shadow-xl pointer-events-none select-none"
        >
          <!-- Slides Track -->
          <div 
            id="home-about-slider-track" 
            class="flex w-full"
            style="transform: translateX(-100%); transition: transform 1200ms cubic-bezier(0.4, 0, 0.2, 1);"
          >
            {displaySlides.map((img, idx) => (
              <div class="w-full shrink-0 relative">
                <img 
                  src={img.src} 
                  alt={img.alt} 
                  class="w-full h-80 sm:h-96 object-cover pointer-events-none"
                  loading={idx <= 2 ? "eager" : "lazy"}
                  draggable="false"
                />
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initHomeAboutSlider() {
    const track = document.getElementById("home-about-slider-track");
    if (!track) return;

    const totalRealSlides = 5; // kuta-5, kuta-6, kuta-7, kuta-8, kuta-9
    let currentIndex = 1; // Dimulai dari slide 1 asli (kuta-5)
    let isAnimating = false;
    let timer: number | null = null;

    const DISPLAY_TIME = 2000; // 2 detik diam pada setiap foto
    const TRANSITION_STYLE = "transform 1200ms cubic-bezier(0.4, 0, 0.2, 1)"; // Gerakan slow, lembut, dan elegan

    function goToSlide(index: number, animated = true) {
      if (isAnimating && animated) return;
      if (animated) isAnimating = true;

      currentIndex = index;
      track.style.transition = animated ? TRANSITION_STYLE : "none";
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function nextSlide() {
      goToSlide(currentIndex + 1, true);
    }

    track.addEventListener("transitionend", (e) => {
      if (e.target !== track) return;
      isAnimating = false;

      // Wrap around seamless clone logic (tanpa rewind mundur kasar)
      if (currentIndex === totalRealSlides + 1) { // mencapai clone dari slide pertama (indeks 6)
        track.style.transition = "none";
        currentIndex = 1; // reset instan ke slide asli pertama (indeks 1)
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        void track.offsetHeight; // force reflow
      } else if (currentIndex === 0) {
        track.style.transition = "none";
        currentIndex = totalRealSlides; // reset instan ke slide asli terakhir (indeks 5)
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        void track.offsetHeight; // force reflow
      }

      // Jadwalkan slide berikutnya setelah 2 detik diam
      scheduleNext();
    });

    function scheduleNext() {
      if (timer !== null) {
        clearTimeout(timer);
      }
      timer = window.setTimeout(() => {
        nextSlide();
      }, DISPLAY_TIME);
    }

    // Mulai pergantian otomatis setelah jeda awal 2 detik
    scheduleNext();
  }

  // Inisialisasi saat DOM siap dan transisi halaman Astro
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHomeAboutSlider);
  } else {
    initHomeAboutSlider();
  }
  document.addEventListener("astro:page-load", initHomeAboutSlider);
</script>
