---
import { getLangFromUrl } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import { icons } from "../lib/icons";

const url = Astro.url;
const lang = getLangFromUrl(url);
const isEn = lang === "en";

interface Props {
  bg?: string;
}

const { bg = "bg-white" } = Astro.props;

const facilities = [
  {
    icon: icons.hardHat,
    title: isEn ? "2 Sanitized SNI Helmets" : "2 Helm SNI Higienis",
    desc: isEn 
      ? "Clean, sterilized, and fresh SNI standard helmets for two riders' safety." 
      : "Helm standar SNI bersih, steril, dan wangi untuk keamanan berkendara berdua.",
  },
  {
    icon: icons.umbrella,
    title: isEn ? "Ready-to-Use Raincoats" : "Jas Hujan Siap Pakai",
    desc: isEn 
      ? "2 sets of quality raincoats always ready in the trunk for rainy weather." 
      : "2 set jas hujan berkualitas yang selalu siap di bagasi motor saat cuaca hujan.",
  },
  {
    icon: icons.truck,
    title: isEn ? "Free Delivery Area Kuta" : "Free Delivery Area Kuta",
    desc: isEn 
      ? "Free drop-off and pick-up directly to your hotel, villa, or stay in Kuta." 
      : "Antar dan jemput unit langsung ke hotel, villa, atau penginapanmu di Kuta.",
  },
  {
    icon: icons.headphones,
    title: isEn ? "24/7 Emergency Assistance" : "Layanan Darurat 24 Jam",
    desc: isEn 
      ? "Local team on standby to help whenever needed during your rental period." 
      : "Tim lokal siap siaga membantu jika ada kendala di jalan selama masa sewa.",
  },
];
---

<!-- Section: Fasilitas Sewa (2x2 Layout, Solid Blue Badges, No Cards, Directly on Pure White) -->
<section class={`${bg} pt-4 sm:pt-8 pb-16 sm:pb-24`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-16 gap-y-8 sm:gap-y-10">
      {facilities.map((item, idx) => {
        return (
          <div class="reveal group flex items-start gap-4 sm:gap-5" style={`animation-delay: ${idx * 100}ms`}>
            <!-- Icon Badge: Solid Blue (#0284C7), White Icon, Rounded Square, No Card Frame -->
            <div class="flex h-14 w-14 sm:h-16 sm:w-16 shrink-0 items-center justify-center rounded-[6px] bg-[#0284C7] text-white shadow-sm transition-transform duration-300 group-hover:scale-105 group-hover:shadow-md">
              <Icon name={item.icon} class="icon-tilt h-7 w-7 stroke-[1.8] sm:h-8 sm:w-8" aria-hidden="true" />
            </div>

            <!-- Text Block: Title & Description (No Card Container) -->
            <div class="flex-1 min-w-0 pt-0.5">
              <h3 class="text-base sm:text-lg font-bold text-[#1E293B] tracking-tight">
                {item.title}
              </h3>
              <p class="mt-1 sm:mt-1.5 text-xs sm:text-sm text-[#5F7380] leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
