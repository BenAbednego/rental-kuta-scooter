---
import { fetchMotorById } from '../../../lib/api';
import { getLangFromUrl } from '../../../i18n/utils';

export const prerender = false;

const { motor_id } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const motor = await fetchMotorById(motor_id as string);

if (!motor) {
  return Astro.redirect(`/${lang}/katalog`);
}

return Astro.redirect(`/${lang}/motor/${motor.slug}`);
---
